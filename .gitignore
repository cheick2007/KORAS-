# ==========================================
# KORAS - Configuration Git Ignore Officielle
# ==========================================

# IDE & Editeurs
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace

# Gradle & Builds
.gradle/
build/
backend/build/
backend/*/build/
!gradle/wrapper/gradle-wrapper.jar
!backend/gradle/wrapper/gradle-wrapper.jar

# Flutter & Mobile
.dart_tool/
.packages
.pub-cache/
.pub/
mobile_app/build/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/.dart_tool/

# Fichiers internes, spécifications & documents temporaires
.kiro/
.kiro/**
docs/
*.tmp
*.log
*.bak
*.swp
*.sql

# Utilitaires de présentation & exécutables locaux
cloudflared.exe
backend/cloudflared.exe
*.pptx
~$*.pptx
generate_deck.py

# Fichiers Système
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
